{
	"compilerOptions": {
		"baseUrl": "./",
		"declaration": false,
		"forceConsistentCasingInFileNames": true,
		"jsx": "react",
		"lib": [
			"ES2023",
			"dom"
		],
		"module": "esnext",
		"moduleResolution": "node",
		"newLine": "LF",
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"outDir": "Target",
		"rootDir": "src",
		"sourceMap": true,
		"strict": true,
		"target": "ES2023"
	},
	"extends": "@playform/build/tsconfig",
	"include": [
		"src",
		"src",
		"src"
	]
}
